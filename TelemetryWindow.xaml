<Window x:Class="ACCRPMMonitor.TelemetryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACC Tire Telemetry"
        Height="550"
        Width="750"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Left="20"
        Top="20">

    <!-- Semi-transparent dark background -->
    <Border Background="#CC000000"
            CornerRadius="10"
            Padding="20"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Header -->
            <TextBlock Grid.Row="0"
                       Text="TIRE TELEMETRY"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <!-- Current Lap Data -->
            <Border Grid.Row="2" Background="#20FFFFFF" CornerRadius="5" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Current Pressure -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PRESSURE (PSI)"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#FFCC00"
                                   Margin="0,0,0,10"
                                   HorizontalAlignment="Center"/>

                        <!-- Pressure Grid -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Front Left -->
                            <Border Grid.Row="0" Grid.Column="0"
                                    Background="#30FFFFFF"
                                    CornerRadius="5"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="FL" FontSize="11" Foreground="#999999" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="PressureFLText"
                                               Text="0.0"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Front Right -->
                            <Border Grid.Row="0" Grid.Column="2"
                                    Background="#30FFFFFF"
                                    CornerRadius="5"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="FR" FontSize="11" Foreground="#999999" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="PressureFRText"
                                               Text="0.0"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Rear Left -->
                            <Border Grid.Row="2" Grid.Column="0"
                                    Background="#30FFFFFF"
                                    CornerRadius="5"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="RL" FontSize="11" Foreground="#999999" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="PressureRLText"
                                               Text="0.0"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Rear Right -->
                            <Border Grid.Row="2" Grid.Column="2"
                                    Background="#30FFFFFF"
                                    CornerRadius="5"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="RR" FontSize="11" Foreground="#999999" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="PressureRRText"
                                               Text="0.0"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Pressure Average -->
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center">
                            <Run Text="Avg: " FontSize="12" Foreground="#999999"/>
                            <Run x:Name="PressureAvgText" Text="0.0" FontSize="12" FontWeight="Bold" Foreground="White"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Current Temperature -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TEMPERATURE (°C)"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#FF6600"
                                   Margin="0,0,0,10"
                                   HorizontalAlignment="Center"/>

                        <!-- Temperature Grid -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Front Left -->
                            <Border Grid.Row="0" Grid.Column="0"
                                    Background="#30FFFFFF"
                                    CornerRadius="5"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="FL" FontSize="11" Foreground="#999999" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TempFLText"
                                               Text="0.0"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Front Right -->
                            <Border Grid.Row="0" Grid.Column="2"
                                    Background="#30FFFFFF"
                                    CornerRadius="5"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="FR" FontSize="11" Foreground="#999999" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TempFRText"
                                               Text="0.0"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Rear Left -->
                            <Border Grid.Row="2" Grid.Column="0"
                                    Background="#30FFFFFF"
                                    CornerRadius="5"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="RL" FontSize="11" Foreground="#999999" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TempRLText"
                                               Text="0.0"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Rear Right -->
                            <Border Grid.Row="2" Grid.Column="2"
                                    Background="#30FFFFFF"
                                    CornerRadius="5"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="RR" FontSize="11" Foreground="#999999" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TempRRText"
                                               Text="0.0"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Temperature Average -->
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center">
                            <Run Text="Avg: " FontSize="12" Foreground="#999999"/>
                            <Run x:Name="TempAvgText" Text="0.0" FontSize="12" FontWeight="Bold" Foreground="White"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Lap Comparison Section -->
            <Border Grid.Row="4" Background="#20FFFFFF" CornerRadius="5" Padding="15" x:Name="LapComparisonBorder" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="LAP COMPARISON"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#00FF00"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Lap Start -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="LAP START" FontSize="11" FontWeight="Bold" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock x:Name="LapStartPressure" Text="Pressure: 0.0 PSI" FontSize="10" Foreground="White" HorizontalAlignment="Center" Margin="0,2"/>
                            <TextBlock x:Name="LapStartTemp" Text="Temp: 0.0 °C" FontSize="10" Foreground="White" HorizontalAlignment="Center" Margin="0,2"/>
                        </StackPanel>

                        <!-- Lap End -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="LAP END" FontSize="11" FontWeight="Bold" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock x:Name="LapEndPressure" Text="Pressure: 0.0 PSI" FontSize="10" Foreground="White" HorizontalAlignment="Center" Margin="0,2"/>
                            <TextBlock x:Name="LapEndTemp" Text="Temp: 0.0 °C" FontSize="10" Foreground="White" HorizontalAlignment="Center" Margin="0,2"/>
                        </StackPanel>

                        <!-- Delta -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DELTA" FontSize="11" FontWeight="Bold" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock x:Name="LapDeltaPressure" Text="Pressure: +0.0 PSI" FontSize="10" HorizontalAlignment="Center" Margin="0,2"/>
                            <TextBlock x:Name="LapDeltaTemp" Text="Temp: +0.0 °C" FontSize="10" HorizontalAlignment="Center" Margin="0,2"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
