<Window x:Class="ACCRPMMonitor.TelemetryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACC Telemetry Monitor"
        Height="600"
        Width="900"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="#1E1E1E"
        Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="ACC Telemetry Monitor"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center"/>

        <!-- Vehicle Info -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="Speed: " FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="SpeedText" Text="0 km/h" FontSize="16" Margin="5,0,20,0"/>

            <TextBlock Text="RPM: " FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="RpmText" Text="0" FontSize="16" Margin="5,0,20,0"/>

            <TextBlock Text="Gear: " FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="GearText" Text="N" FontSize="16" Margin="5,0,20,0"/>

            <TextBlock Text="Fuel: " FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="FuelText" Text="0 L" FontSize="16" Margin="5,0"/>
        </StackPanel>

        <!-- Tire Data Grid -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Side - Tire Pressure -->
            <Border Grid.Column="0"
                    BorderBrush="#3A3A3A"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="15">
                <StackPanel>
                    <TextBlock Text="Tire Pressure (PSI)"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,15"
                               HorizontalAlignment="Center"/>

                    <!-- Pressure Grid -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Front Left -->
                        <Border Grid.Row="0" Grid.Column="0"
                                Background="#2D2D30"
                                CornerRadius="4"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="FL" FontSize="14" Foreground="#808080" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PressureFLText"
                                           Text="0.0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Front Right -->
                        <Border Grid.Row="0" Grid.Column="2"
                                Background="#2D2D30"
                                CornerRadius="4"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="FR" FontSize="14" Foreground="#808080" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PressureFRText"
                                           Text="0.0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Rear Left -->
                        <Border Grid.Row="2" Grid.Column="0"
                                Background="#2D2D30"
                                CornerRadius="4"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="RL" FontSize="14" Foreground="#808080" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PressureRLText"
                                           Text="0.0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Rear Right -->
                        <Border Grid.Row="2" Grid.Column="2"
                                Background="#2D2D30"
                                CornerRadius="4"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="RR" FontSize="14" Foreground="#808080" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PressureRRText"
                                           Text="0.0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Average -->
                        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                Background="#252526"
                                CornerRadius="4"
                                Padding="10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Average: " FontSize="16" Foreground="#808080"/>
                                <TextBlock x:Name="PressureAvgText"
                                           Text="0.0 PSI"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="5,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Right Side - Tire Temperature -->
            <Border Grid.Column="2"
                    BorderBrush="#3A3A3A"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="15">
                <StackPanel>
                    <TextBlock Text="Tire Temperature (°C)"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,15"
                               HorizontalAlignment="Center"/>

                    <!-- Temperature Grid -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Front Left -->
                        <Border Grid.Row="0" Grid.Column="0"
                                Background="#2D2D30"
                                CornerRadius="4"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="FL" FontSize="14" Foreground="#808080" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TempFLText"
                                           Text="0.0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Front Right -->
                        <Border Grid.Row="0" Grid.Column="2"
                                Background="#2D2D30"
                                CornerRadius="4"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="FR" FontSize="14" Foreground="#808080" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TempFRText"
                                           Text="0.0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Rear Left -->
                        <Border Grid.Row="2" Grid.Column="0"
                                Background="#2D2D30"
                                CornerRadius="4"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="RL" FontSize="14" Foreground="#808080" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TempRLText"
                                           Text="0.0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Rear Right -->
                        <Border Grid.Row="2" Grid.Column="2"
                                Background="#2D2D30"
                                CornerRadius="4"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="RR" FontSize="14" Foreground="#808080" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TempRRText"
                                           Text="0.0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Average -->
                        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                Background="#252526"
                                CornerRadius="4"
                                Padding="10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Average: " FontSize="16" Foreground="#808080"/>
                                <TextBlock x:Name="TempAvgText"
                                           Text="0.0 °C"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="5,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="3"
                   x:Name="StatusText"
                   Text="Waiting for telemetry data..."
                   FontSize="12"
                   Foreground="#808080"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0"/>
    </Grid>
</Window>
