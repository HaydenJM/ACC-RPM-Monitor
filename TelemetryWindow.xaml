<Window x:Class="ACCRPMMonitor.TelemetryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACC Telemetry Overlay"
        Height="400"
        Width="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Left="20"
        Top="20">

    <!-- Semi-transparent dark background -->
    <Border Background="#CC000000"
            CornerRadius="10"
            Padding="15"
            BorderBrush="#40FFFFFF"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Vehicle Info Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="Speed: " FontSize="14" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="SpeedText" Text="0" FontSize="14" Foreground="#00FF00" Margin="2,0,15,0"/>

                <TextBlock Text="RPM: " FontSize="14" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="RpmText" Text="0" FontSize="14" Foreground="#00FF00" Margin="2,0,15,0"/>

                <TextBlock Text="Gear: " FontSize="14" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="GearText" Text="N" FontSize="14" Foreground="#00FF00" Margin="2,0,15,0"/>

                <TextBlock Text="Fuel: " FontSize="14" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="FuelText" Text="0" FontSize="14" Foreground="#00FF00" Margin="2,0"/>
            </StackPanel>

            <!-- Tire Data Grid -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Side - Tire Pressure -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PRESSURE (PSI)"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#AAAAAA"
                               Margin="0,0,0,8"
                               HorizontalAlignment="Center"/>

                    <!-- Pressure Grid -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Front Left -->
                        <Border Grid.Row="0" Grid.Column="0"
                                Background="#30FFFFFF"
                                CornerRadius="4"
                                Padding="8">
                            <StackPanel>
                                <TextBlock Text="FL" FontSize="10" Foreground="#999999" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PressureFLText"
                                           Text="0.0"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Front Right -->
                        <Border Grid.Row="0" Grid.Column="2"
                                Background="#30FFFFFF"
                                CornerRadius="4"
                                Padding="8">
                            <StackPanel>
                                <TextBlock Text="FR" FontSize="10" Foreground="#999999" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PressureFRText"
                                           Text="0.0"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Rear Left -->
                        <Border Grid.Row="2" Grid.Column="0"
                                Background="#30FFFFFF"
                                CornerRadius="4"
                                Padding="8">
                            <StackPanel>
                                <TextBlock Text="RL" FontSize="10" Foreground="#999999" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PressureRLText"
                                           Text="0.0"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Rear Right -->
                        <Border Grid.Row="2" Grid.Column="2"
                                Background="#30FFFFFF"
                                CornerRadius="4"
                                Padding="8">
                            <StackPanel>
                                <TextBlock Text="RR" FontSize="10" Foreground="#999999" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PressureRRText"
                                           Text="0.0"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Pressure Average -->
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center">
                        <Run Text="Avg: " FontSize="11" Foreground="#999999"/>
                        <Run x:Name="PressureAvgText" Text="0.0" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </TextBlock>
                </StackPanel>

                <!-- Right Side - Tire Temperature -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="TEMPERATURE (°C)"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#AAAAAA"
                               Margin="0,0,0,8"
                               HorizontalAlignment="Center"/>

                    <!-- Temperature Grid -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Front Left -->
                        <Border Grid.Row="0" Grid.Column="0"
                                Background="#30FFFFFF"
                                CornerRadius="4"
                                Padding="8">
                            <StackPanel>
                                <TextBlock Text="FL" FontSize="10" Foreground="#999999" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TempFLText"
                                           Text="0.0"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Front Right -->
                        <Border Grid.Row="0" Grid.Column="2"
                                Background="#30FFFFFF"
                                CornerRadius="4"
                                Padding="8">
                            <StackPanel>
                                <TextBlock Text="FR" FontSize="10" Foreground="#999999" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TempFRText"
                                           Text="0.0"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Rear Left -->
                        <Border Grid.Row="2" Grid.Column="0"
                                Background="#30FFFFFF"
                                CornerRadius="4"
                                Padding="8">
                            <StackPanel>
                                <TextBlock Text="RL" FontSize="10" Foreground="#999999" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TempRLText"
                                           Text="0.0"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Rear Right -->
                        <Border Grid.Row="2" Grid.Column="2"
                                Background="#30FFFFFF"
                                CornerRadius="4"
                                Padding="8">
                            <StackPanel>
                                <TextBlock Text="RR" FontSize="10" Foreground="#999999" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TempRRText"
                                           Text="0.0"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Temperature Average -->
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center">
                        <Run Text="Avg: " FontSize="11" Foreground="#999999"/>
                        <Run x:Name="TempAvgText" Text="0.0" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
